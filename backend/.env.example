APP_NAME=OpsPilot API
APP_VERSION=0.1.0
ENVIRONMENT=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opspilot
DB_USER=opspilot_app
DB_PASSWORD=your-db-password-here
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Provider
# Set LLM_PROVIDER to "gemini" or leave as "mock" for local dev without API keys.
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
GEMINI_API_KEY=

# OpenTelemetry
OTEL_SERVICE_NAME=opspilot-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4319
OTEL_EXPORTER_OTLP_INSECURE=true

# RAG / Vector Store
RAG_ENABLED=true
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
PINECONE_API_KEY=
PINECONE_INDEX_NAME=opspilot-knowledge
PINECONE_NAMESPACE=opspilot
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
