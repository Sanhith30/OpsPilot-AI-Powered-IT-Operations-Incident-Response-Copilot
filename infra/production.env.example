# ==============================================================================
# OpsPilot Production Environment Configuration (.env.production)
# ==============================================================================

# Application Environment
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# Networking & Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg://opspilot_admin:REPLACE_WITH_SECURE_PASSWORD@opspilot-postgres.internal:5432/opspilot
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication & Security
# Generate via: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_HEX_32_BYTE_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Models & Providers
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Pinecone Vector Search
PINECONE_API_KEY=REPLACE_WITH_PINECONE_API_KEY
PINECONE_INDEX_NAME=opspilot-knowledge
PINECONE_ENVIRONMENT=us-east-1

# Observability (OpenTelemetry / Prometheus)
OTEL_SERVICE_NAME=opspilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# Rate Limiting & Abuse Prevention
RATE_LIMIT_DEFAULT_PER_MIN=600
RATE_LIMIT_AUTH_PER_MIN=30
